# Placeholder-only template. Copy to .env.local; never commit populated values.
# Local development origin; set the real deployment origin in Vercel separately.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project settings -> API / API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local/app secret: base64-encoded 32 random bytes, not a provider API key.
CREDENTIAL_ENCRYPTION_KEY=

# Daily: call transport + integrated Deepgram transcription for the live path
DAILY_API_KEY=
DAILY_WEBHOOK_SECRET=

# Deepgram: direct upload transcription; separate from Daily billing
DEEPGRAM_API_KEY=

# OpenAI: existing funded API account; model access still needs a smoke test
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Extraction uses Claude for this developer's hackathon path.
# ANTHROPIC_WORKSPACE_ID is required when the key is not already scoped to one workspace.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Linear OAuth: app credentials, not the connected Codex plugin's credentials
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# Hackathon personal-key shortcut; OAuth (LINEAR_CLIENT_ID/SECRET) is still the team path.
LINEAR_API_KEY=
# Shiproom team UUID allowed to use the server personal key; unset disables the shortcut.
LINEAR_DEMO_TEAM_ID=
# Fallback GitHub repo for Cursor when a meeting has none selected (scripted /demo).
CURSOR_PR_REPO=WeebPapi/acme-repo-picker

# GitHub App: only needed for private repository context
# GitHub login OAuth credentials are configured in Supabase, not here.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Inngest Cloud keys; local dev uses the installed SDK's dev-server settings
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
